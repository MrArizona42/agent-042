# Canonical operator environment template for both local checkout runs and the
# single-node deployment contract.
#
# Local checkout usage:
# - Copy this file to `.env` in the repo root.
# - Run Compose from the checkout:
#     docker compose --env-file .env -f infra/compose/docker-compose.yaml up --build -d
# - Local Python entrypoints and notebooks also load the repo-root `.env`.
#
# Deployment usage:
# - Render the same keys to `/home/anton-m/agent-042/.env`.
# - Deploy automation passes that external env file to Compose from the active release.
#
# Current repo state:
# - Phase 2 Compose consumes `PROJECT_ROOT`, `ASSETS_ROOT`, `ARTIFACTS_ROOT`, and
#   `DVC_CONFIG_LOCAL_PATH` for shared-root mounts.
# - Airflow temp-clone DVC/Git sync consumes `GITHUB_REPOSITORY` and
#   `GITHUB_DATA_SYNC_TOKEN`.
# - Phase 4 Compose also resolves repo-built service images from `GITHUB_REPOSITORY`
#   and `IMAGE_TAG`; local checkout runs can still use `docker compose up --build`.
#
# Internal service-to-service endpoints such as PLATFORM__VLLM_BASE_URL,
# PLATFORM__EMBEDDINGS_URL, GATEWAY__URL, PLATFORM__QDRANT_HOST, and
# PLATFORM__MLFLOW_TRACKING_URI are intentionally omitted here:
# - Compose injects internal Docker-network values directly.
# - Host-side Python runs fall back to localhost-oriented settings defaults.

PROJECT_ROOT=C:/Users/user/MyGitRepos/agent-042
ASSETS_ROOT=C:/Users/user/MyGitRepos/agent-042/assets
ARTIFACTS_ROOT=C:/Users/user/MyGitRepos/agent-042/artifacts
DVC_CONFIG_LOCAL_PATH=C:/Users/user/MyGitRepos/agent-042/.dvc/config.local
COMPOSE_PROJECT_NAME=agent-042
IMAGE_TAG=local  # local checkout builds only; GHCR pulls use <branch-slug>-latest or <branch-slug>-<sha12>
GITHUB_REPOSITORY=your-org-or-user/agent-042   # CHANGE ME! Phase 2 Airflow Git write-back
GITHUB_DATA_SYNC_TOKEN=your-github-token-here  # CHANGE ME! Phase 2 Airflow Git write-back

# =====================
# PostgreSQL
# =====================
# NOTE: must be defined before any variable that references ${POSTGRES_*}
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=your-postgres-password-here  # CHANGE ME!
POSTGRES_PORT=5432

# =====================
# MLflow server config
# =====================
MLFLOW_PORT=5050
MLFLOW_SERVER_ALLOWED_HOSTS=agent.antonlab.ru,agent.antonlab.ru:8443,antonlab.ru,localhost:5000,localhost:5050,127.0.0.1:5050,127.0.0.1,mlflow,mlflow:5000
MLFLOW_BACKEND_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
MLFLOW_ARTIFACT_ROOT=s3://agent-042-mlflow-artifacts/mlflow
# Optional MLflow client auth for local scripts and notebooks.
MLFLOW_TRACKING_USERNAME=your-username-here     # CHANGE ME! if auth is enabled
MLFLOW_TRACKING_PASSWORD=your-password-here     # CHANGE ME! if auth is enabled

# =====================
# Yandex Object Storage
# =====================
MLFLOW_S3_ENDPOINT_URL=https://storage.yandexcloud.net
AWS_DEFAULT_REGION=ru-central1
AWS_ACCESS_KEY_ID=your-access-key-here          # CHANGE ME!
AWS_SECRET_ACCESS_KEY=your-secret-key-here      # CHANGE ME!

# =====================
# vLLM service
# =====================
# You can set either an HF model id (e.g. Qwen/Qwen3-0.6B)
# or a local path under assets/models (e.g. /models/ministral/Ministral-3b-instruct).
VLLM_MODEL=/models/Qwen/Qwen3-0.6B
VLLM_PORT=8000
VLLM_DTYPE=float16
VLLM_QUANT=bitsandbytes
VLLM_GPU_UTIL=0.7
VLLM_GPU_COUNT=1
# Hard scheduler caps for request concurrency and prefill chunk size.
# For 12 GB GPUs with long context, start conservatively and scale up only
# after checking KV-cache usage and startup stability.
VLLM_MAX_NUM_SEQS=1
VLLM_MAX_NUM_BATCHED_TOKENS=1024
VLLM_KV_CACHE_DTYPE=fp8
VLLM_MAX_LORAS=4
VLLM_MAX_LORA_RANK=16

# =====================
# Model Registry (LoRA adapter sync)
# =====================
# Optional override for a non-bundled operator registry file.
# Relative paths resolve from the repo root; leave empty to use src/shared/catalog.toml.
CATALOG__PATH=
ADAPTER_REGISTRY__SYNC_ALIASES=champion,challenger
ADAPTER_REGISTRY__ADAPTERS_DIR=./assets/adapters

# =====================
# Qdrant Vector Database
# =====================
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# =====================
# Agent Gateway (FastAPI)
# =====================
GATEWAY_PORT=9001
RAG__RAG_ENABLED=true
RAG__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG__EMBEDDING_DEVICE=cpu
GATEWAY__ASYNC_ENABLED=true

# =====================
# Evaluation / LLM-as-Judge
# =====================
# Host-side eval scripts and notebooks resolve these through the shared root settings.
# Docker services override container-to-container endpoints in docker-compose.yaml
# and should use service DNS such as http://gateway:9000 instead of localhost.
# The local judge config is explicit and mandatory.
GATEWAY__URL=http://localhost:${GATEWAY_PORT}
AUTH__INTERNAL_API_KEY=your-internal-api-key-here          # CHANGE ME!
EVAL__DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/agent042
EVAL__JUDGE__BACKEND=local_vllm
EVAL__JUDGE__MODEL=/models/Qwen/Qwen3-0.6B
# Only required when EVAL__JUDGE__BACKEND=openai_compatible.
EVAL__JUDGE__BASE_URL=
EVAL__JUDGE__API_KEY=
EVAL__JUDGE__TIMEOUT=60.0
EVAL__JUDGE__REQUEST_DELAY_SECONDS=0.0
EVAL__METRICS__BERT_SCORE_MODEL=microsoft/deberta-v3-base
EVAL__METRICS__TEMPERATURE=0.0
EVAL__METRICS__MAX_COMPLETION_TOKENS=2048
EVAL__SANDBOX__CODE_EXEC_TIMEOUT=30
EVAL__SANDBOX__CODE_EXEC_MEM_LIMIT=512m
EVAL__SANDBOX__CODE_EXEC_CPUS=1.0

# =====================
# OAuth2 / OIDC (Google)
# =====================
AUTH__GOOGLE_CLIENT_ID=your-google-client-id-here          # CHANGE ME!
AUTH__GOOGLE_CLIENT_SECRET=your-google-client-secret-here  # CHANGE ME!
AUTH__GOOGLE_REDIRECT_URI=https://agent.antonlab.ru:8443/auth/callback
AUTH__AGENT042_DB_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/agent042
AUTH__SESSION_SECRET_KEY=your-session-secret-key-here      # CHANGE ME!
AUTH__SESSION_TTL_SECONDS=86400

# =====================
# RabbitMQ (Message Broker)
# =====================
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=agent
RABBITMQ_PASS=your-rabbitmq-password-here       # CHANGE ME!

# =====================
# Redis (Pub/Sub Streaming)
# =====================
REDIS_PORT=6379

# =====================
# Agent UI (Streamlit)
# =====================
UI_PORT=8501

# =====================
# Flower (Celery Monitoring)
# =====================
FLOWER_PORT=5555

# =====================
# RedisInsight (Redis Monitoring)
# =====================
REDISINSIGHT_PORT=5540

# =====================
# Apache Airflow
# =====================
AIRFLOW_PORT=8080
AIRFLOW_DB=airflow
AIRFLOW_FERNET_KEY=your-fernet-key-here         # CHANGE ME!
AIRFLOW_JWT_SECRET=your-jwt-secret-here         # CHANGE ME!
AIRFLOW_JWT_ISSUER=airflow
AIRFLOW_ADMIN_USER=admin                        # CHANGE ME!
AIRFLOW_ADMIN_PASSWORD=your-airflow-password-here  # CHANGE ME!

# =====================
# JupyterLab
# =====================
JUPYTER_PORT=8888
JUPYTER_TOKEN=your-jupyter-token-here           # CHANGE ME!

# =====================
# Grafana
# =====================
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here  # CHANGE ME!

# =====================
# Prometheus
# =====================
PROMETHEUS_PORT=9090
