PROJECT_ROOT=C:/Users/user/MyGitRepos/agent-042

# =====================
# MLflow server config
# =====================

# Port on the host machine
MLFLOW_PORT=5050
MLFLOW_SERVER_ALLOWED_HOSTS=agent.antonlab.ru,agent.antonlab.ru:8443,antonlab.ru,localhost:5000,127.0.0.1

# Backend store (PostgreSQL) — password must match POSTGRES_PASSWORD above
MLFLOW_BACKEND_URI=postgresql://mlflow:your-postgres-password-here@postgres:5432/mlflow  # CHANGE ME!

# Default artifact root (Yandex Object Storage bucket)
# IMPORTANT: this bucket already exists and is shared with DVC
MLFLOW_ARTIFACT_ROOT=s3://agent-042-mlflow-artifacts/mlflow

# =====================
# Yandex Object Storage
# =====================

# S3-compatible endpoint for Yandex Cloud
MLFLOW_S3_ENDPOINT_URL=https://storage.yandexcloud.net

# Region is required by boto3, even if ignored
AWS_DEFAULT_REGION=ru-central1

# Access credentials
AWS_ACCESS_KEY_ID=your-access-key-here         # CHANGE ME!
AWS_SECRET_ACCESS_KEY=your-secret-key-here     # CHANGE ME!

# =====================
# PostgreSQL
# =====================

POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=your-postgres-password-here  # CHANGE ME!
POSTGRES_PORT=5432

# =====================
# vLLM service
# =====================
# OpenAI-compatible vLLM server config
# You can set either an HF model id (e.g., Qwen/Qwen3-0.6B) or a local path under assets/models (e.g., /models/ministral/Ministral-3b-instruct)
VLLM_MODEL=/models/Qwen/Qwen3-0.6B
VLLM_PORT=8000
# dtype: auto, float16, bfloat16
VLLM_DTYPE=float16
# quantization: bitsandbytes, awq, gptq, none
VLLM_QUANT=bitsandbytes
# GPU memory utilization (0-1)
VLLM_GPU_UTIL=0.7
# Optional: number of GPUs to reserve (set to 1 by default)
VLLM_GPU_COUNT=1
# Optional: KV cache dtype (auto, fp8, float16)
VLLM_KV_CACHE_DTYPE=fp8
# Multi-LoRA support: max number of LoRA adapters loaded simultaneously
VLLM_MAX_LORAS=4
# Max LoRA rank (must be >= the rank used during training, e.g. lora.r=8)
VLLM_MAX_LORA_RANK=16

# =====================
# Qdrant Vector Database
# =====================
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# =====================
# Agent Gateway (FastAPI)
# =====================
GATEWAY_PORT=9001
# vLLM base URL reachable from gateway container
GATEWAY_VLLM_BASE_URL=http://vllm:8000
# Qdrant connection from gateway container
GATEWAY_QDRANT_HOST=qdrant
GATEWAY_QDRANT_PORT=6333
# RAG system configuration
GATEWAY_RAG_ENABLED=true
# Lightweight embedding model for RTX 3060 (12GB VRAM)
# This model takes ~400MB VRAM, leaving ~8-9GB for vLLM
GATEWAY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Async inference (Phase 1): when enabled, uses Celery workers instead of direct vLLM calls
GATEWAY_ASYNC_ENABLED=true

# =====================
# RabbitMQ (Message Broker)
# =====================
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=agent
RABBITMQ_PASS=your-rabbitmq-password-here      # CHANGE ME!

# =====================
# Redis (Pub/Sub Streaming)
# =====================
REDIS_PORT=6379

# =====================
# Agent UI (Streamlit)
# =====================
UI_PORT=8501
# gateway URL reachable from UI container
GATEWAY_URL=http://gateway:9000

# =====================
# Flower (Celery Monitoring)
# =====================
FLOWER_PORT=5555

# =====================
# RedisInsight (Redis Monitoring)
# =====================
REDISINSIGHT_PORT=5540

# =====================
# Apache Airflow (LocalExecutor)
# =====================
AIRFLOW_PORT=8080
AIRFLOW_DB=airflow

# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your-fernet-key-here        # CHANGE ME! (generate with command above)

AIRFLOW_ADMIN_USER=admin                       # CHANGE ME!
AIRFLOW_ADMIN_PASSWORD=your-airflow-password-here  # CHANGE ME!

# =====================
# JupyterLab
# =====================
JUPYTER_PORT=8888
JUPYTER_TOKEN=your-jupyter-token-here          # CHANGE ME!
