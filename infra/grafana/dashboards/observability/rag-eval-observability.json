        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (task, dataset_name, knowledge_base, metric_name, rag_alias) task, dataset_name, knowledge_base, metric_name, rag_alias, metric_value, qdrant_collection, rag_manifest_id, created_at FROM eval_runs WHERE rag_enabled = true AND rag_alias IN ('champion', 'challenger') ORDER BY task, dataset_name, knowledge_base, metric_name, rag_alias, created_at DESC), pivot AS (SELECT task, dataset_name, knowledge_base, metric_name, max(metric_value) FILTER (WHERE rag_alias = 'champion') AS champion, max(metric_value) FILTER (WHERE rag_alias = 'challenger') AS challenger, max(qdrant_collection) FILTER (WHERE rag_alias = 'champion') AS champion_collection, max(qdrant_collection) FILTER (WHERE rag_alias = 'challenger') AS challenger_collection, max(rag_manifest_id) FILTER (WHERE rag_alias = 'champion') AS champion_manifest, max(rag_manifest_id) FILTER (WHERE rag_alias = 'challenger') AS challenger_manifest FROM latest GROUP BY task, dataset_name, knowledge_base, metric_name) SELECT *, challenger - champion AS delta FROM pivot WHERE champion IS NOT NULL OR challenger IS NOT NULL ORDER BY task, dataset_name, knowledge_base, metric_name",
          "refId": "A"
        }
      ],
      "title": "Latest Challenger Delta",
      "type": "table"
    },
