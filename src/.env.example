# =============================================================================
# Agent-042 Environment Configuration
# =============================================================================
# Copy this file to .env and customize values for your environment.
# All variables have sensible defaults for local development.

# =============================================================================
# vLLM / Inference Settings
# =============================================================================
# URL where vLLM server is reachable
# - Docker Compose: http://vllm:8000
# - Local development: http://localhost:8000
GATEWAY_VLLM_BASE_URL=http://localhost:8000

# Default model when none specified in request
# Should match the model served by vLLM
GATEWAY_DEFAULT_MODEL=/models/Qwen/Qwen3-0.6B

# Optional API key for vLLM authentication (leave empty if not needed)
GATEWAY_API_KEY=

# Timeout for vLLM requests in seconds
GATEWAY_VLLM_TIMEOUT=60.0

# =============================================================================
# Gateway Service Settings
# =============================================================================
# Allowed CORS origins (comma-separated, use * for all)
GATEWAY_CORS_ALLOW_ORIGINS=*

# Service name displayed in API documentation
GATEWAY_SERVICE_NAME=agent-042-gateway

# Public URL for the gateway API (optional, for external documentation)
GATEWAY_PUBLIC_BASE_URL=

# =============================================================================
# Qdrant / Vector Store Settings
# =============================================================================
# Qdrant server hostname
# - Docker Compose: qdrant
# - Local development: localhost
GATEWAY_QDRANT_HOST=localhost

# Qdrant server port
GATEWAY_QDRANT_PORT=6333

# =============================================================================
# RAG Settings
# =============================================================================
# Enable/disable RAG functionality
GATEWAY_RAG_ENABLED=true

# HuggingFace model for embeddings
# Lightweight (~80MB, fast): sentence-transformers/all-MiniLM-L6-v2
# Better quality (~420MB): sentence-transformers/all-mpnet-base-v2
GATEWAY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Device for embedding model: cpu, cuda, mps
# Use 'cpu' to save GPU memory for vLLM
GATEWAY_EMBEDDING_DEVICE=cpu

# Batch size for embedding generation
GATEWAY_EMBEDDING_BATCH_SIZE=32

# Number of documents to retrieve
GATEWAY_TOP_K=5

# Minimum similarity score for retrieval (0.0 to 1.0)
GATEWAY_SCORE_THRESHOLD=0.0

# Maximum character length of RAG context
GATEWAY_CONTEXT_MAX_LENGTH=4000

# =============================================================================
# Chunking Settings
# =============================================================================
# Default chunk size for document splitting
GATEWAY_CHUNK_SIZE=512

# Default overlap between chunks
GATEWAY_CHUNK_OVERLAP=50

# Chunk size for code documents
GATEWAY_CODE_CHUNK_SIZE=1000

# Overlap for code chunks
GATEWAY_CODE_CHUNK_OVERLAP=100

# Chunk size for section-aware splitting (papers/docs)
GATEWAY_SECTION_CHUNK_SIZE=1024

# Overlap for section chunks
GATEWAY_SECTION_CHUNK_OVERLAP=100

# =============================================================================
# UI / Client Settings
# =============================================================================
# Full URL to the gateway (used by UI service)
# - Docker Compose: http://gateway:9000
# - Local development: http://localhost:9001
GATEWAY_URL=http://localhost:9001

# UI request timeouts in seconds
UI_HEALTH_TIMEOUT=10.0
UI_MODELS_TIMEOUT=30.0
UI_CHAT_TIMEOUT=300.0
