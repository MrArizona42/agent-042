# =============================================================================
# Agent-042 Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# Only external-service secrets belong here — all other settings have
# defaults in src/shared/config.py; per-environment wiring (DB URLs,
# service hostnames, etc.) is handled by docker-compose / Helm / Terraform.

# =============================================================================
# Secrets
# =============================================================================
# API key for vLLM authentication (leave empty if not needed)
GATEWAY_API_KEY=

# Google OAuth2 credentials (required for OIDC login)
GATEWAY_GOOGLE_CLIENT_ID=
GATEWAY_GOOGLE_CLIENT_SECRET=
GATEWAY_GOOGLE_REDIRECT_URI=

# Secret key for signing session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
GATEWAY_SESSION_SECRET_KEY=

# Pre-shared key for internal service-to-service calls (e.g. Airflow eval runner)
GATEWAY_INTERNAL_API_KEY=

# Google AI Studio API key for Gemini judge (eval runner)
EVAL_GOOGLE_AI_API_KEY=
